CREATE VIEW product_catalog AS
SELECT
  p.id,
  p.name,
  c.name AS category,
  p.description,
  p.price,
  p.sku,
  p.stock,
  p.accent,
  p.featured,
  p.active
FROM products p
JOIN categories c ON c.id = p.category_id
WHERE p.active = 1;
